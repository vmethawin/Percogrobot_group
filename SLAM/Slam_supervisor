from controller import Supervisor
import numpy as np
import math
import random
import matplotlib.pyplot as plt

class GridMap:
    def __init__(self, length, height, resolution):
        self.length = length
        self.height = height
        self.resolution = resolution
        self.cols = int(length / resolution)
        self.rows = int(height / resolution)
        self.grid = np.zeros((self.rows, self.cols))

    def update_map(self, x_real, y_real):
        col = int((x_real + self.length / 2) / self.resolution)
        row = int((y_real + self.height / 2) / self.resolution)
        row = self.rows - 1 - row # Invert row so +Y is up
        
        if 0 <= col < self.cols and 0 <= row < self.rows:
            self.grid[row, col] = 1 # 1 represents an obstacle

def get_coordinate(supervisor):
    robot_node = supervisor.getSelf()
    position = robot_node.getPosition()
    R = robot_node.getOrientation()
    return position[0], position[1], math.atan2(R[3], R[0])
    
def get_point_cloud(lidar_device):
    wb_point_cloud = lidar_device.getPointCloud()
    points = []
    
    for p in wb_point_cloud:
        # 1. Ignore infinity/NaN (invalid readings)
        if math.isinf(p.x) or math.isnan(p.x) or math.isinf(p.y) or math.isinf(p.z):
            continue
            
        # 2. CHASSIS FILTER: Ignore points that are too close to the sensor
        # (p.x^2 + p.y^2 + p.z^2 is the squared distance from the sensor)
        if (p.x**2 + p.y**2 + p.z**2) < 0.15:
            continue
            
        # 3. FLOOR FILTER: Ignore points that are too low to the ground!
        # NOTE: You may need to tweak this -0.2 value depending on exactly 
        # how high your Velodyne is mounted on your robot.
        if p.z < 0.1: 
            continue
            
        # Optional: CEILING FILTER (if you are indoors and getting ceiling noise)
        # if p.z > 1.0:
        #     continue

        points.append([p.x, p.y, p.z])
        
    return np.array(points)
if __name__ == "__main__":
    supervisor = Supervisor()
    timestep = int(supervisor.getBasicTimeStep())
    supervisor.simulationSetMode(Supervisor.SIMULATION_MODE_FAST)
    # 1. Initialize Map
    my_map = GridMap(length=20.0, height=20.0, resolution=0.1)
    
    # 2. Initialize LIDAR
    lidar = supervisor.getDevice('Velodyne VLP-16')
    lidar.enable(timestep)
    lidar.enablePointCloud()
    
    # 3. Initialize Motors (Ensure names match your robot)
    left_motor = supervisor.getDevice('left wheel')
    right_motor = supervisor.getDevice('right wheel')
    left_motor.setPosition(float('inf'))
    right_motor.setPosition(float('inf'))
    left_motor.setVelocity(0.0)
    right_motor.setVelocity(0.0)
    
    # --- NEW: Setup Matplotlib Live Visualizer ---
    plt.ion() # Turn on interactive mode
    fig, ax = plt.subplots()
    ax.set_title("Live 2D Occupancy Grid")
    
    # Display the empty grid. 'Greys' colormap: 0=white (empty), 1=black (obstacle)
    img_plot = ax.imshow(my_map.grid, cmap='Greys', origin='upper', vmin=0, vmax=1)
    plt.show()
    
    # Navigation Variables
    max_speed = 5.0
    turn_timer = 0
    loop_counter = 10
    
    print("Starting Mapping... Check the Matplotlib window!")

    while supervisor.step(timestep) != -1:
        loop_counter += 1
        
        x, y, theta = get_coordinate(supervisor)
        points = get_point_cloud(lidar)
        
        obstacle_ahead = False
        
        for p in points:
            p_x, p_y = p[0], p[1]
            m = math.hypot(p_x, p_y)
            n = math.atan2(p_y, p_x)
            
            obs_x = x + m * math.cos(theta + n)
            obs_y = y + m * math.sin(theta + n)
            
            my_map.update_map(obs_x, obs_y)
            
            if m < 1.0 and abs(n) < 0.5:
                obstacle_ahead = True

        # --- NEW: Update the visualizer every 20 frames ---
        # We skip frames so the plotting doesn't slow down the robot's movement
        if loop_counter % 20 == 0:
            img_plot.set_data(my_map.grid)
            plt.pause(0.001) # Allows Matplotlib to redraw the window

        # --- Movement Logic ---
        if turn_timer > 0:
            turn_timer -= 1
        elif obstacle_ahead:
            left_motor.setVelocity(-max_speed)
            right_motor.setVelocity(max_speed)
            turn_timer = random.randint(20, 50)
        else:
            left_motor.setVelocity(max_speed)
            right_motor.setVelocity(max_speed)
